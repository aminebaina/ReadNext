# ==========================================
# ReadNext Environment Configuration
# ==========================================

# Qloo Hackathon API Key (Required for taste-graph queries)
# Obtain from the Qloo Agentic Hackathon portal
# Target endpoint: https://hackathon.api.qloo.com
QLOO_API_KEY="your_qloo_hackathon_api_key_here"

# Google Gemini API Key (Required for LLM Agent & Safety Gate)
# In Google AI Studio, injected automatically or configured via Secrets panel
GEMINI_API_KEY="your_gemini_api_key_here"

# Gemini Model alias (Fast Flash class model)
# Supported: gemini-3.8-flash, gemini-flash-latest
GEMINI_MODEL="gemini-3.8-flash"

# Port (optional, defaults to 3000)
PORT=3000

# Daily Gemini safety budget cap to prevent quota exhaustion
DAILY_GEMINI_BUDGET=500
